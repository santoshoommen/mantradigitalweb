# Public site URL used for canonical links, sitemap and structured data.
# Example: https://mantradigitalmagic.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional social profiles. Leave blank until the URLs are confirmed.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Google Analytics 4 measurement ID. Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=G-54RRC0Q4G5

# Sanity. Leave blank to use the seeded content in src/lib/content.ts.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-10-15

# Resend. Required in production before the contact form can notify the team.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Set to true to also send a plain acknowledgement to the person who enquired.
CONTACT_SEND_ACKNOWLEDGEMENT=false

# Optional Cloudflare Turnstile. Both keys are required before it is enforced.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated extra origins allowed to POST to the contact API.
ALLOWED_ORIGINS=
